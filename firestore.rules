rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin accounts, matched by provider-verified email on the auth
    // token (Google Sign-In is the only auth method, so this is safe
    // without a separate custom-claims setup). This list MUST exactly
    // match VITE_ADMIN_EMAILS in your .env — rules files can't read
    // env vars, so the two have to be kept in sync by hand whenever
    // you add or remove an admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'dreamcanvasacademy@gmail.com',
          'adnansite01@gmail.com'
        ];
    }

    // Each user's own profile + notes. Only that user (or the admin)
    // can read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /watchProgress/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /personalSpace/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Sections (the public catalog) and their roadmap items / resources.
    match /sections/{sectionId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Only the section's creator or the admin can edit/delete the
      // section itself (title, description, pin, order, category…).
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.createdBy || isAdmin());

      // Access-code hash for paid sections lives here, NOT on the
      // public section doc above, so it isn't bundled into every
      // catalog read. Still not bulletproof — anyone signed in can
      // read the hash and attempt to crack it offline; a real
      // server-side check would need a Cloud Function, which isn't
      // available on the free tier here. See PROGRESS.md.
      match /private/access {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      match /items/{itemId} {
        // Free sections stay open to everyone. Paid sections require
        // at least being signed in to read their roadmap at all —
        // the access-code check itself is a client-side UX gate on
        // top of this, not an additional server-side rule (see note
        // above on why that's the honest limit here).
        allow read: if get(/databases/$(database)/documents/sections/$(sectionId)).data.isPaid != true
          || request.auth != null;
        // Admin-only creation now (DeshiEdu moved from open
        // contribution to admin-curated content). update/delete stay
        // open to whoever originally added an item, so anything
        // contributed under the old model can still be managed by its
        // creator — just nothing new can be added except by the admin.
        allow create: if isAdmin();
        allow update, delete: if request.auth != null
          && (request.auth.uid == resource.data.addedBy || isAdmin());
      }

      match /resources/{resourceId} {
        allow read: if get(/databases/$(database)/documents/sections/$(sectionId)).data.isPaid != true
          || request.auth != null;
        allow create: if isAdmin();
        allow update, delete: if request.auth != null
          && (request.auth.uid == resource.data.addedBy || isAdmin());
      }
    }

    // Everything else is denied by default — no catch-all rule.
  }
}
