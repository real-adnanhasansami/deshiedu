# Copy this file to .env and fill in real values from the Firebase console.
# Never commit the real .env file — it should be in .gitignore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Must match the admin email hardcoded in firestore.rules (isAdmin()) —
# rules files can't read .env, so keep both in sync by hand.
VITE_ADMIN_EMAIL=dreamcanvasacademy@gmail.com
